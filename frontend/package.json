{
  "name": "weld-decision-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "完井措施决策四幕演示站（纯静态 · 离线单文件 · 只读 bundle.json）",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
