    "verify": "npm run typecheck && npm run build && npm run acceptance"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "naive-ui": "^2.45.3",
    "pinia": "^4.1.0",
    "three": "^0.170.0",
