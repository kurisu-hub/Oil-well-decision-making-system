    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "puppeteer-core": "^25.16.0",
    "terser": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-singlefile": "^2.3.4",
    "vue-tsc": "^3.3.13"
  }
}
